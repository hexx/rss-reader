# AI プロバイダ（OpenAI 互換エンドポイント）
# AI_BASE_URL には任意の OpenAI 互換エンドポイントを指定できます。
# 標準設定は OpenAI 本家の GPT-5.6 Luna（Responses API）です。
#   - OpenAI 本家:            https://api.openai.com/v1
#   - DeepSeek 公式 API:       https://api.deepseek.com
#   - 各社の OpenAI 互換ゲートウェイ（Anthropic 等をプロキシするものも含む）
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=replace-me
AI_MODEL=gpt-5.6-luna
AI_API=openai-responses
AI_REASONING_EFFORT=medium

# AI_API は openai-completions / openai-responses を指定できます。
# 未設定時は openai-completions です。
# AI_REASONING_EFFORT は off / low / medium / high / xhigh / max を指定できます。
# 未設定時は medium です。GPT-5.6 Luna では minimal は使用できません。

# ローカルの Ollama を使う場合は次のように指定します（キー不要なサーバでも
# AI_API_KEY 自体は必須のため、ダミー値を入れてください）。
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.2
# AI_API=openai-completions
# AI_REASONING_EFFORT=off

# Cloudflare bindings (set in wrangler.toml / Cloudflare dashboard)
# DB
